# ============================================
# Environment Variables for URL Shortener
# ============================================
# 🔒 SECURITY: Copy this file to .env and set secure values
# NEVER commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
# 🚨 CRITICAL: Change this password in production!
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=urlshortener

# ============================================
# Redis Configuration
# ============================================
# 🚨 CRITICAL: Set a password in production!
REDIS_PASSWORD=your_redis_password_here

# ============================================
# Application Configuration
# ============================================
# Base URL for generated short links
BASE_URL=http://localhost

# ============================================
# Docker Hub (for CI/CD)
# ============================================
# These should be set as GitHub Secrets, not here
# DOCKER_USERNAME=your-username
# DOCKER_TOKEN=your-token

# ============================================
# AWS (for Terraform - Optional)
# ============================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
